CONFIG_ATH11K_MEM_PROFILE_512M=y
CONFIG_NSS_FIRMWARE_VERSION_11_4=y
CONFIG_PACKAGE_luci-app-athena-led=m
CONFIG_PACKAGE_luci-i18n-athena-led-zh-cn=m

# ====================== 1. MWAN3 + MWAN3HELP 多线负载均衡 + 全套依赖 ======================
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_luci-app-mwan3helper=y
CONFIG_PACKAGE_luci-i18n-mwan3-zh-cn=y
CONFIG_PACKAGE_luci-i18n-mwan3helper-zh-cn=y
# MWAN3 必备网络依赖
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_iptables-mod-ipset=y
CONFIG_PACKAGE_kmod-ipt-ipset=y

# ====================== 2. OpenClash 全套 + 依赖（兼容 NSS，推荐主力使用） ======================
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_openclash=y
# 核心依赖
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_iptables=y
CONFIG_PACKAGE_iptables-mod-tproxy=y
CONFIG_PACKAGE_iptables-mod-conntrack-extra=y
CONFIG_PACKAGE_kmod-ipt-tproxy=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_libcap=y
CONFIG_PACKAGE_libcurl=y
CONFIG_PACKAGE_libopenssl=y
# 域名/IP 规则依赖
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_bash=y

# ====================== 3. 常用 LuCI 主题（多款主流主题，按需保留/删减） ======================
# Aurora 主题（你当前在用）
CONFIG_PACKAGE_luci-theme-aurora=y
# Argon 热门主题
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
# Bootstrap / Dark 系主题
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-theme-dark=y
# Edge 主题
CONFIG_PACKAGE_luci-theme-edge=y
# Material 主题
CONFIG_PACKAGE_luci-theme-material=y

# ====================== 4. 补充实用工具（补 opkg、文件传输，解决你之前上传/安装问题） ======================
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_opkg-update=y
CONFIG_PACKAGE_luci-app-filetransfer=y
CONFIG_PACKAGE_luci-i18n-filetransfer-zh-cn=y

# 5. AdGuardHome 广告过滤+加密DNS 全套依赖
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_adguardhome=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_libustream-openssl=y
CONFIG_PACKAGE_libpthread=y

# 6. 新增主题：Edge / OpenWrt / OpenWrt2000
CONFIG_PACKAGE_luci-theme-edge=y
CONFIG_PACKAGE_luci-theme-openwrt=y
CONFIG_PACKAGE_luci-theme-openwrt2000=y

# 7. Mihomo 代理插件及依赖
CONFIG_PACKAGE_luci-app-mihomo=y
CONFIG_PACKAGE_mihomo=y

CONFIG_PACKAGE_f2fs-tools=n
CONFIG_PACKAGE_f2fsck=n
CONFIG_PACKAGE_btrfs-progs=n
CONFIG_PACKAGE_xfs-progs=n
CONFIG_PACKAGE_exfatprogs=n
CONFIG_PACKAGE_mtd-utils=n
